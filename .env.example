# Supabase — get values from your project's Settings → API page.
# Local dev: copy this to .env.local and fill in the local Supabase values
# (default Supabase local URL is http://127.0.0.1:54321).
# Production: set these in Vercel project settings, never commit.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to a Client Component or NEXT_PUBLIC prefix.
SUPABASE_SERVICE_ROLE_KEY=

# FLTT Progress Tracker (Mongo) — only needed for scripts/import-fltt-catalog.ts.
# Real values come from Dataset/DATASET_HANDOFF.md — never commit them.
MONGODB_URI=
MONGODB_DB_NAME=

# FLTT match-history backup (Cloudflare R2) — only needed for the R2 player-history
# importer (lib/import/r2-player-history.ts, scripts/simulate-season-ttr-r2.ts).
# Real values come from the dataset owner's R2-integration-guide-PRIVATE.md — never commit them.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
