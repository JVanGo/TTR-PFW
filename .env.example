# Supabase — get values from your project's Settings → API page.
# Local dev: copy this to .env.local and fill in the local Supabase values
# (default Supabase local URL is http://127.0.0.1:54321).
# Production: set these in Vercel project settings, never commit.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to a Client Component or NEXT_PUBLIC prefix.
SUPABASE_SERVICE_ROLE_KEY=
